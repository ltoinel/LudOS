{
  "name": "ludos",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "description": "LudOS — A full Web Shell Terminal supporting Web LLM and experimental agentic features.",
  "author": "Ludovic Toinel",
  "license": "MIT",
  "homepage": "https://ludovic.toinel.com",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "node scripts/ensure-site-config.ts",
    "predev": "node scripts/ensure-site-config.ts",
    "prebuild": "node scripts/ensure-site-config.ts && node scripts/keep-assets.ts stash",
    "precheck": "node scripts/ensure-site-config.ts",
    "pretest": "node scripts/ensure-site-config.ts",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:commands": "node scripts/check-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro",
    "upgrade": "ncu",
    "upgrade:apply": "ncu -u && npm install && npm run build",
    "msg-server": "node server/msg-server.ts",
    "coverage": "vitest run --coverage && node scripts/update-badges.ts",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "deploy:config": "node scripts/deploy-config.ts",
    "postbuild": "node scripts/keep-assets.ts restore"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.8.0",
    "astro-icon": "^1.1.5",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "npm-check-updates": "^17.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
