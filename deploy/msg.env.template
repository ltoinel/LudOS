# Environment for the `msg` email relay (server/msg-server.ts), rendered by
# `npm run deploy:config`. Copy to {{BASE_DIR}}/msg.env (outside the web root)
# and set MSG_TO.
MSG_TO=you@example.com
# MSG_FROM=terminal@<your domain>   (default: terminal@ + the host of site.url)
MSG_HOST=127.0.0.1
MSG_PORT=8787
# MSG_ORIGIN=https://<your domain>  (default: site.url)
# Optional append-only attempt log (must be writable by the service user).
# MSG_LOG={{BASE_DIR}}/data/msg.log
