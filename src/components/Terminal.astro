---
import { site, openLinks, siteHost } from '../site.config.ts';
import pkg from '../../package.json';

// Runtime config injected into the client shell (read back via #shell-cfg). It is
// tiny, so it stays inline; the large filesystem + command registry are fetched
// from /shell-fs.json and /shell-commands.json (cached, shared across pages).
const cfg = {
  ...site.shell,
  // Build-time host (from `site.url`); the client swaps in the domain actually
  // serving the page (see initTerminal).
  host: siteHost,
  links: openLinks,
  // Release shown by the boot banner / `uname` (the package.json version).
  version: pkg.version,
  // Identity surfaced by the `whoami` command — mirrored from the site config so
  // there is a single source of truth.
  profile: {
    name: site.name,
    role: site.role,
    company: site.company,
    nationality: site.nationality,
    knowsAbout: site.knowsAbout,
    url: site.url,
  },
};
const safe = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c');
---

<section class="ssh-win needs-js" id="ssh" aria-label={`Interactive terminal — ${siteHost}`}>
  <header class="ssh-bar" id="ssh-bar">
    <span class="ssh-dots">
      <button
        type="button"
        class="ssh-ctl"
        data-act="close"
        style="background:#ff5f56"
        aria-label="Close the session"></button>
      <button
        type="button"
        class="ssh-ctl"
        data-act="min"
        style="background:var(--amber)"
        aria-label="Minimize"></button>
      <button
        type="button"
        class="ssh-ctl"
        data-act="max"
        style="background:var(--green)"
        aria-label="Maximize / restore"></button>
    </span>
    <span class="ssh-title">ssh — {site.shell.user}: ~</span>
    <span class="ssh-status"><span class="ssh-led"></span> connected</span>
  </header>

  <div class="ssh-body" id="ssh-body" role="log" aria-live="polite" tabindex="-1">
    <div class="ssh-output" id="ssh-output"></div>
    <div class="ssh-inputline" id="ssh-inputline" hidden>
      <span class="ssh-prompt" id="ssh-prompt"></span><span
        class="ssh-typed"
        id="ssh-typed"
        aria-hidden="true"></span>
      <input
        class="ssh-input"
        id="ssh-input"
        type="text"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="Type a command"
      />
    </div>
  </div>

  <span class="ssh-grip" aria-hidden="true"></span>
</section>

<script type="application/json" id="shell-cfg" is:inline set:html={safe(cfg)} />

<script>
  import { bootTerminal } from '../lib/terminal';
  bootTerminal();
</script>
